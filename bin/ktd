set -e

usage()
{
    local scriptname=$0

    cat <<EOF

This script lets you manage your KTD environment.

Usage:

    $scriptname [--search-engine <engine>|--plugins|--selenium|--sso|--localrun|--mana|--mana-url|--marcflavour <flavour>] up -d
    $scriptname down [instance_name|--all]
    $scriptname [--search-engine <engine>|--plugins|--selenium|--sso|--localrun|--mana|--mana-url|--marcflavour <flavour>] pull
    $scriptname [--root] --shell
    $scriptname --dbshell
    $scriptname --logs
    $scriptname -h|--help

Options:

    --search-engine ENGINE Use specified search engine (use 'list' to see options)
    --db-engine ENGINE     Use specified database engine (mariadb, mysql) - auto-detected from DB_IMAGE if not specified
    --plugins             Enable plugin development environment
    --single-plugin PATH  Mount a single plugin from PATH to /kohadevbox/plugins/
    --selenium            Use a Selenium container
    --mana                Connects koha to the mana network
    --mana-url 'url'      Sets the mana-url
    --sso                 Use a Keycloak container
    --shell               Get into the Koha container
    --dbshell             Get into the database
    --run 'command'       Execute a command inside the shell (requires --shell)
    --wait-ready N        Wait N secs until KTD is up and running
    --persistent-db       Make this instance's DB persistent
    --proxy               Use the proxied version of the compose file
    --name                Sets the project name
    --localrun            Start the container with local run.sh file
    --local-db            Bind MySQL/MariaDB to localhost (useful for Cypress tests)
    --marcflavour         Set the MARC flavour (e.g., MARC21, UNIMARC, NORMARC)
    --file|-f             Compose configuration files
    --logs                Follow the koha container logs
    --list                Print the list of running KTD instances
    --help|-h             Display this help message

Environment variables:

    KTD_HOME              Mandatory. Needs to point to a clone of koha-testing-docker
    KTD_PROJECT           Optional. For using with the compose -p option (default: 'koha')
    DB_IMAGE              Optional. Override database image (e.g., mariadb:11.0, mysql:8.4)
    KOHA_SEARCH_ENGINE_IMAGE Optional. Override search engine image

EOF
}

# Add handle_down_command function here, before it's used
handle_down_command() {
    local instance=$1

    if [ "$instance" = "--all" ]; then
        # Get all instance names and bring them down
        docker ps -a --format '{{.Names}}' | grep 'koha-1' | sed 's/-koha-1//' | sort -u | \
        while read project; do
            if [ -n "$project" ]; then
                echo "Bringing down project: $project"
                "$DOCKER_BINARY" compose --project-directory ${KTD_HOME} -p "$project" down
                echo
            fi
        done
    elif [ -n "$instance" ]; then
        # Bring down specific instance
        if docker ps -a --format '{{.Names}}' | grep -q "${instance}-koha-1"; then
            echo "Bringing down project: $instance"
            container_count=$(docker ps -a --format '{{.Names}}' | grep "^${instance}-" | wc -l)
            "$DOCKER_BINARY" compose --project-directory ${KTD_HOME} -p "$instance" down
        else
            echo "Error: Instance '$instance' not found"
            exit 1
        fi
    else
        # Default behavior - bring down current instance
        echo "Bringing down project: ${PROJECT_NAME}"
        container_count=$(docker ps -a --format '{{.Names}}' | grep "^${PROJECT_NAME}-" | wc -l)
        "$DOCKER_BINARY" compose --project-directory ${KTD_HOME} -p ${PROJECT_NAME} down
    fi
}

set_docker()
{
    if [ -z "$DOCKER_BINARY" ]; then

        export DOCKER_BINARY="$(which docker)"

    fi
}

set_searchengine()
{
    if [ "$ENABLED_SEARCHENGINE" == "" ]; then

        ENABLED_SEARCHENGINE=$1

        if [ "$ENABLED_SEARCHENGINE" = "zebra" ]; then
            # Zebra is the default, no SEARCH_ENGINE_IMAGE needed
            SEARCH_ENGINE_IMAGE=""
            SEARCH_ENGINE_TYPE=""
        elif [ "$ENABLED_SEARCHENGINE" = "os1" ]; then
            SEARCH_ENGINE_IMAGE="koha/opensearch-icu:1"
            SEARCH_ENGINE_TYPE="opensearch"
        elif [ "$ENABLED_SEARCHENGINE" = "os2" ]; then
            SEARCH_ENGINE_IMAGE="koha/opensearch-icu:2"
            SEARCH_ENGINE_TYPE="opensearch"
        elif [ "$ENABLED_SEARCHENGINE" = "os3" ]; then
            SEARCH_ENGINE_IMAGE="koha/opensearch-icu:3"
            SEARCH_ENGINE_TYPE="opensearch"
        elif [ "$ENABLED_SEARCHENGINE" = "es6" ]; then
            SEARCH_ENGINE_IMAGE="koha/elasticsearch-icu:6"
            SEARCH_ENGINE_TYPE="elastic"
        elif [ "$ENABLED_SEARCHENGINE" = "es7" ]; then
            SEARCH_ENGINE_IMAGE="koha/elasticsearch-icu:7"
            SEARCH_ENGINE_TYPE="elastic"
        elif [ "$ENABLED_SEARCHENGINE" = "es8" ]; then
            SEARCH_ENGINE_IMAGE="koha/elasticsearch-icu:8"
            SEARCH_ENGINE_TYPE="elastic"
        elif [ "$ENABLED_SEARCHENGINE" = "es9" ]; then
            SEARCH_ENGINE_IMAGE="koha/elasticsearch-icu:9"
            SEARCH_ENGINE_TYPE="elastic"
        fi

        # Check for environment variable override
        if [ -n "$KOHA_SEARCH_ENGINE_IMAGE" ]; then
            SEARCH_ENGINE_IMAGE="$KOHA_SEARCH_ENGINE_IMAGE"
        fi

        # Multi-arch images don't need arch suffix anymore
        export SEARCH_ENGINE_IMAGE="${SEARCH_ENGINE_IMAGE}"
        export SEARCH_ENGINE_TYPE=$SEARCH_ENGINE_TYPE

        # Keep ES_IMAGE for backward compatibility
        export ES_IMAGE="${SEARCH_ENGINE_IMAGE}"
        export ES_IMAGE_TYPE=$SEARCH_ENGINE_TYPE
    else
        printf "\nError: only one search engine option is allowed (you passed $ENABLED_SEARCHENGINE and $1)\n\n"
        usage
        exit 1
    fi
}

set_arch()
{
    UNAME=$(uname -m)
    ARCH=""
    if [ "$UNAME" == "arm64" ] ||  [ "$UNAME" == "aarch64" ] ; then
        ARCH="arm64v8"
    fi

    export ARCH=$ARCH
}

toggle_plugins()
{
    if [ "$SINGLE_PLUGIN_PATH" != "" ] && [ "$ENABLE_PLUGINS" != "no" ]; then
        printf "\nError: --plugins and --single-plugin are mutually exclusive\n\n"
        usage
        exit 1
    fi
}

ENV_DB_IMAGE=$DB_IMAGE
ENV_ES_IMAGE=$ES_IMAGE
ENV_KOHA_IMAGE=$KOHA_IMAGE
ENV_KOHA_MARC_FLAVOUR=$KOHA_MARC_FLAVOUR
ENV_KOHA_SEARCH_ENGINE_IMAGE=$KOHA_SEARCH_ENGINE_IMAGE

source $KTD_HOME/.env

# ENV overrides sourced config, only if not empty
[ "$ENV_DB_IMAGE"          != "" ] &&          DB_IMAGE=$ENV_DB_IMAGE
[ "$ENV_ES_IMAGE"          != "" ] &&          ES_IMAGE=$ENV_ES_IMAGE
[ "$ENV_KOHA_IMAGE"        != "" ] &&        KOHA_IMAGE=$ENV_KOHA_IMAGE
[ "$ENV_KOHA_MARC_FLAVOUR" != "" ] && KOHA_MARC_FLAVOUR=$ENV_KOHA_MARC_FLAVOUR
[ "$ENV_KOHA_SEARCH_ENGINE_IMAGE" != "" ] && KOHA_SEARCH_ENGINE_IMAGE=$ENV_KOHA_SEARCH_ENGINE_IMAGE

set_docker
set_arch

WAIT_READY="no"

ENABLED_SEARCHENGINE=""
ENABLED_DB_ENGINE=""

ENABLE_PLUGINS="no"
SINGLE_PLUGIN_PATH=""
ENABLE_SELENIUM="no"
ENABLE_MANA="no"
ENABLE_SSO="no"
ENABLE_LOCAL_RUN_SCRIPT="no"
ENABLE_BUILD_IMAGE="no"
PERSISTENT_DB="no"
BIND_LOCAL_DB="no"

KOHA_SEARCH_ENGINE_ENABLED="no"

PROJECT_NAME="kohadev"

ROOT_ACCESS="no"
RUN=""
SHELL_ACCESS="no"
DBSHELL_ACCESS="no"
LIST_INSTANCES="no"

COMPOSE_FILES=()

FOLLOW_LOGS="no"

USE_PROXY="no"

# Read command line parameters
while [ $# -gt 0 ]; do

    case "$1" in
        -h|--help)
            usage ; exit 0 ;;
        -v|--verbose)
            verbose="yes"
            shift ;;
        --logs)
            FOLLOW_LOGS="yes"
            break ;;
        --es6)
            printf "\nDEPRECATION WARNING: --es6 is deprecated. Use '--search-engine es6' instead.\n\n"
            exit 1 ;;
        --es7)
            printf "\nDEPRECATION WARNING: --es7 is deprecated. Use '--search-engine es7' instead.\n\n"
            exit 1 ;;
        --es8)
            printf "\nDEPRECATION WARNING: --es8 is deprecated. Use '--search-engine es8' instead.\n\n"
            exit 1 ;;
        --os1)
            printf "\nDEPRECATION WARNING: --os1 is deprecated. Use '--search-engine os1' instead.\n\n"
            exit 1 ;;
        --os2)
            printf "\nDEPRECATION WARNING: --os2 is deprecated. Use '--search-engine os2' instead.\n\n"
            exit 1 ;;
        --search-engine)
            case "$2" in
                list)
                    echo "Valid search engines:"
                    echo "  zebra  - Zebra search engine (default)"
                    echo "  es6    - Elasticsearch 6.x"
                    echo "  es7    - Elasticsearch 7.x"
                    echo "  es8    - Elasticsearch 8.x"
                    echo "  es9    - Elasticsearch 9.x"
                    echo "  os1    - OpenSearch 1.x"
                    echo "  os2    - OpenSearch 2.x"
                    echo "  os3    - OpenSearch 3.x"
                    exit 0
                    ;;
                zebra|es6|es7|es8|es9|os1|os2|os3)
                    set_searchengine "$2"
                    ;;
                *)
                    printf "\nError: invalid search engine '$2'. Use '--search-engine list' to see valid options.\n\n"
                    usage
                    exit 1
                    ;;
            esac
            shift 2 ;;
        --db-engine)
            case "$2" in
                list)
                    echo "Valid database engines:"
                    echo "  mariadb - MariaDB database (version auto-selected based on KOHA_IMAGE OS)"
                    echo "  mysql   - MySQL database (default: mysql:8.0)"
                    echo ""
                    echo "MariaDB version mapping (when DB_IMAGE not set):"
                    echo "  Debian 13 (trixie)                 → mariadb:11.8"
                    echo "  Debian 12 (bookworm)               → mariadb:10.11"
                    echo "  Debian 11 (bullseye)               → mariadb:10.5"
                    echo "  Debian 10 (buster)                 → mariadb:10.3"
                    echo "  Ubuntu 24.04 (noble)               → mariadb:10.11"
                    echo "  Ubuntu 22.04 (jammy)               → mariadb:10.6"
                    echo "  Ubuntu 20.04 (focal)               → mariadb:10.3"
                    echo "  Ubuntu 18.04 (bionic)              → mariadb:10.1"
                    echo ""
                    echo "Override examples:"
                    echo "  DB_IMAGE=mysql:8.0 ktd up          # Auto-detects mysql engine"
                    echo "  DB_IMAGE=mariadb:11.0 ktd up       # Override MariaDB version"
                    echo "  ktd --db-engine mysql up           # Force mysql with default version"
                    exit 0
                    ;;
                mariadb|mysql)
                    if [ "$ENABLED_DB_ENGINE" != "" ]; then
                        printf "\nError: only one database engine option is allowed\n\n"
                        usage
                        exit 1
                    fi
                    ENABLED_DB_ENGINE="$2"
                    ;;
                *)
                    printf "\nError: invalid database engine '$2'. Use '--db-engine list' to see valid options.\n\n"
                    usage
                    exit 1
                    ;;
            esac
            shift 2 ;;
        --persistent-db)
            PERSISTENT_DB="yes"
            shift ;;
        --plugins)
            ENABLE_PLUGINS="yes"
            toggle_plugins
            shift ;;
        --single-plugin)
            SINGLE_PLUGIN_PATH="$2"
            toggle_plugins
            shift 2 ;;
        --proxy)
            USE_PROXY="yes"
            shift ;;
        --name)
            PROJECT_NAME=$2
            shift 2 ;;
        --selenium)
            ENABLE_SELENIUM="yes"
            shift ;;
        --mana)
            ENABLE_MANA="yes"
            shift ;;
        --mana-url)
            SET_MANA_URL="yes"
            mana_url_to_be_set=$2
            shift 2;;
        --sso)
            ENABLE_SSO="yes"
            shift ;;
        --root)
            ROOT_ACCESS="yes"
            shift ;;
        --run)
            RUN=$2
            shift 2 ;;
        --shell)
            SHELL_ACCESS="yes"
            shift ;;
        --dbshell)
            DBSHELL_ACCESS="yes"
            shift ;;
        --wait-ready)
            WAIT_READY="yes"
            WAIT_TIMEOUT=$2
            break ;;
        --localrun)
            ENABLE_LOCAL_RUN_SCRIPT="yes"
            shift ;;
        --build)
            ENABLE_BUILD_IMAGE="yes"
            shift ;;
        --list)
            LIST_INSTANCES="yes";
            break ;;
        --local-db)
            BIND_LOCAL_DB="yes"
            shift ;;
        --marcflavour)
            KOHA_MARC_FLAVOUR=$2
            shift 2 ;;
        -f | --file)
            COMPOSE_FILES+=("$2")
            shift 2
            ;;
        down)
            handle_down_command "$2"
            exit 0 ;;
        -*)
            printf "\nError: expected a docker compose action and got '$1' instead\n\n"
            usage
            exit 1 ;;
        *)
            # We expect the remaining stuff are the instance names
            break ;;
    esac

done

# Set default KOHA_IMAGE to main if not specified
if [ -z "$KOHA_IMAGE" ]; then
    KOHA_IMAGE="main"
    export KOHA_IMAGE
fi

# Set default search engine to zebra if none specified
if [ "$ENABLED_SEARCHENGINE" == "" ]; then
    set_searchengine "zebra"
fi

# Set default database engine based on DB_IMAGE if not specified
if [ "$ENABLED_DB_ENGINE" == "" ]; then
    if [ -n "$DB_IMAGE" ]; then
        case "$DB_IMAGE" in
            mysql:*|percona:*|mysql/*|percona/*)
                ENABLED_DB_ENGINE="mysql"
                ;;
            mariadb:*|mariadb/*)
                ENABLED_DB_ENGINE="mariadb"
                ;;
            *)
                # Default to mariadb for unknown images
                ENABLED_DB_ENGINE="mariadb"
                ;;
        esac
    else
        ENABLED_DB_ENGINE="mariadb"
    fi
fi

# Set default DB_IMAGE based on KOHA_IMAGE OS if not specified
if [ -z "$DB_IMAGE" ] && [ "$ENABLED_DB_ENGINE" = "mariadb" ]; then
    # Default KOHA_IMAGE to main if not set
    KOHA_IMAGE_FOR_DB="${KOHA_IMAGE:-main}"

    case "$KOHA_IMAGE_FOR_DB" in
        *-trixie*|*-d13*)
            DB_IMAGE="mariadb:11.8"
            ;;
        *-bookworm*|*-d12*|main)
            DB_IMAGE="mariadb:10.11"
            ;;
        *-bullseye*|*-d11*)
            DB_IMAGE="mariadb:10.5"
            ;;
        *-buster*|*-d10*)
            DB_IMAGE="mariadb:10.3"
            ;;
        *-stretch*|*-d9*)
            DB_IMAGE="mariadb:10.1"
            ;;
        *-noble*|*-u24*)
            DB_IMAGE="mariadb:10.11"
            ;;
        *-jammy*|*-u22*)
            DB_IMAGE="mariadb:10.6"
            ;;
        *-focal*|*-u20*)
            DB_IMAGE="mariadb:10.3"
            ;;
        *-bionic*|*-u18*)
            DB_IMAGE="mariadb:10.1"
            ;;
        *)
            # Default for unknown OS versions
            DB_IMAGE="mariadb:10.11"
            ;;
    esac
    export DB_IMAGE
fi

# Validate DB_IMAGE and --db-engine compatibility
if [ -n "$DB_IMAGE" ] && [ "$ENABLED_DB_ENGINE" != "" ]; then
    case "$DB_IMAGE" in
        mysql:*|percona:*|mysql/*|percona/*)
            if [ "$ENABLED_DB_ENGINE" != "mysql" ]; then
                printf "\nError: DB_IMAGE '$DB_IMAGE' is not compatible with --db-engine $ENABLED_DB_ENGINE\n"
                printf "Suggestion: Use --db-engine mysql or remove --db-engine (auto-detected)\n\n"
                exit 1
            fi
            ;;
        mariadb:*|mariadb/*)
            if [ "$ENABLED_DB_ENGINE" != "mariadb" ]; then
                printf "\nError: DB_IMAGE '$DB_IMAGE' is not compatible with --db-engine $ENABLED_DB_ENGINE\n"
                printf "Suggestion: Use --db-engine mariadb or remove --db-engine (auto-detected)\n\n"
                exit 1
            fi
            ;;
    esac
fi

if [ "$LIST_INSTANCES" != "no" ]; then
    # Define colors where we need them
    GREEN='\033[0;32m'
    RED='\033[0;31m'
    NC='\033[0m' # No Color

    # Helper function to format and display instances
    display_instances() {
        local status=$1
        local color=$2
        docker ps $3 --format '{{.Names}} {{.Status}}' | grep 'koha-1' | \
        while read line; do
            name=$(echo $line | cut -d' ' -f1 | sed 's/-koha-1//')
            status=$(echo $line | cut -d' ' -f2-)
            printf "%-${max_len}s  [${color}%s${NC}]\n" "$name" "$status"
        done | sort
    }

    # Get max length for formatting
    max_len=$(docker ps -a --format '{{.Names}}' | grep 'koha-1' | sed 's/-koha-1//' | awk '{ print length }' | sort -nr | head -1)

    # Print header
    printf "%-${max_len}s  %s\n" "INSTANCE" "STATUS"
    printf "%-${max_len}s  %s\n" "$(printf '%0.s-' $(seq 1 $max_len))" "---------------"

    # Display running instances first, then stopped ones
    (
        display_instances "running" "${GREEN}" ""
        display_instances "stopped" "${RED}" "-f status=exited"
    )

    exit 0
fi

if [ "${KOHA_INSTANCE}" = "" ]; then
    KOHA_INSTANCE=kohadev
fi

if [ "$WAIT_READY" != "no" ]; then
    if [ -x ${WAIT_TIMEOUT} ]; then
        WAIT_TIMEOUT=100
    fi

    regex='^[0-9]+$'
    if ! [[ $WAIT_TIMEOUT =~ $regex ]] ; then
        printf "ERROR: timeout must be a number (got $WAIT_TIMEOUT)\n"
        exit 1
    fi

    for i in $(seq 1 $WAIT_TIMEOUT); do
        # Check if container is still running
        if ! docker ps -q -f name=${PROJECT_NAME}-koha-1 | grep -q .; then
            printf "\nERROR: Container ${PROJECT_NAME}-koha-1 has stopped or died\n"
            exit 1
        fi

        if docker exec ${PROJECT_NAME}-koha-1 bash -c '[ -e /ktd_ready ]'; then
            printf "\n"
            exit 0
        else
            printf "\rAttempt $i of $WAIT_TIMEOUT"
            sleep 1
        fi
    done

    printf "\nERROR: no more attempts\n"
    exit 1
fi

if [ "$SHELL_ACCESS" != "no" ]; then

    SHELL_USER="--user ${KOHA_INSTANCE}-koha"

    if [ "$ROOT_ACCESS" != "no" ]; then
        SHELL_USER=""
    fi

    if [ "$RUN" != "" ]; then
        "$DOCKER_BINARY" exec ${SHELL_USER} --workdir /kohadevbox/koha ${PROJECT_NAME}-koha-1 bash -c "${RUN}"
    else
        "$DOCKER_BINARY" exec ${SHELL_USER} --workdir /kohadevbox/koha -ti ${PROJECT_NAME}-koha-1 bash
    fi

elif [ "$DBSHELL_ACCESS" != "no" ]; then
    "$DOCKER_BINARY" exec -it ${PROJECT_NAME}-db-1 mysql -u koha_kohadev -ppassword koha_kohadev
elif [ "$FOLLOW_LOGS" != "no" ]; then

    "$DOCKER_BINARY" logs -f ${PROJECT_NAME}-koha-1
else
    # run the KTD command
    if [ -n "$KTD_HOME" ]; then

        if [ -d "$KTD_HOME" ]; then
            # All good :-D

            if [ ! -d "${SYNC_REPO}" ]; then
                printf "\nThe mandatory \$SYNC_REPO variable points to an invalid directory.\nIt needs to point to a Koha clone directory.\n\n"
                usage
                exit 1
            fi

            # save current working directory
            current_dir=$(pwd)
            cd "${KTD_HOME}"

            if [ "${USE_PROXY}" != "yes" ]; then
                COMPOSE_OPTIONS='-f compose/base.yml'
            else
                COMPOSE_OPTIONS='-f compose/base-proxy.yml'
            fi

            for file in "${COMPOSE_FILES[@]}"; do
                COMPOSE_OPTIONS+=" -f $file"
            done

            # Add database engine compose file
            COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/db-${ENABLED_DB_ENGINE}.yml"

            if [ "$ENABLED_SEARCHENGINE" != "" ] && [ "$ENABLED_SEARCHENGINE" != "zebra" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/${SEARCH_ENGINE_TYPE}.yml"
                KOHA_SEARCH_ENGINE_ENABLED="yes"
            fi

            if [ "$ENABLE_PLUGINS" != "no" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/plugins.yml"
            fi

            if [ "$SINGLE_PLUGIN_PATH" != "" ]; then
                if [ ! -d "$SINGLE_PLUGIN_PATH" ]; then
                    printf "\nError: Single plugin path '$SINGLE_PLUGIN_PATH' does not exist or is not a directory\n\n"
                    exit 1
                fi
                export SINGLE_PLUGIN_PATH="$SINGLE_PLUGIN_PATH"
                export SINGLE_PLUGIN_NAME="$(basename "$SINGLE_PLUGIN_PATH")"
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/single_plugin.yml"
            fi

            if [ "$ENABLE_SELENIUM" != "no" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/selenium.yml"
            fi

	        if [ "$ENABLE_MANA" != "no" ]; then
                MANA_URL="http://mana:5000"
                export MANA_URL
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/mana.yml"
            fi

            if [ "$SET_MANA_URL" != "no" ]; then
                export MANA_URL="${mana_url_to_be_set}"
            fi

            if [ "$ENABLE_SSO" != "no" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/sso.yml"
            fi

            if [ "$PERSISTENT_DB" != "no" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/persistent_db.yml"
            fi

            if [ "$ENABLE_BUILD_IMAGE" != "no" ]; then
                if [ -z "${KOHA_IMAGE_OS}" ] && [ "$1" != "down" ]; then
                    printf "\n\$KOHA_IMAGE_OS not set, but build requested. Please set it correctly and retry\n\n"
                    exit 1
                fi
                export KOHA_IMAGE_OS=${KOHA_IMAGE_OS}
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/build.yml"
            fi

            if [ "$BIND_LOCAL_DB" != "no" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/local_db.yml"
            fi
            # worktree? need to jump to the koha clone
            cd ${SYNC_REPO}
            if [ "$(git rev-parse --git-dir)" != ".git" ]; then
                GIT_WORKTREE_SOURCE=$(git rev-parse --git-common-dir)
                export GIT_WORKTREE_SOURCE="${GIT_WORKTREE_SOURCE%%/.git*}"
                printf "\nDetected Git worktree. Mounting ${GIT_WORKTREE_SOURCE}\n\n"
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/worktree.yml"
            fi
            # back to KTD clone
            cd ${KTD_HOME}

            if [ "$ENABLE_LOCAL_RUN_SCRIPT" != "no" ]; then
                COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -f compose/localrun.yml"
            fi

            export KOHA_SEARCH_ENGINE_ENABLED="${KOHA_SEARCH_ENGINE_ENABLED}"
            # Keep KOHA_ELASTICSEARCH for backward compatibility (used in run.sh)
            export KOHA_ELASTICSEARCH="${KOHA_SEARCH_ENGINE_ENABLED}"
            export KOHA_MARC_FLAVOUR="${KOHA_MARC_FLAVOUR}"

            COMPOSE_OPTIONS="${COMPOSE_OPTIONS} -p ${PROJECT_NAME}"

            export KOHA_INSTANCE=${PROJECT_NAME}

            if [ "$1" = "down" ]; then
                "$DOCKER_BINARY" compose --project-directory ${KTD_HOME} -p ${PROJECT_NAME} down
            else
                "$DOCKER_BINARY" compose --project-directory ${KTD_HOME} ${COMPOSE_OPTIONS} $@
            fi

            # back to the original working directory
            cd "${current_dir}"
        else
            printf "\nThe mandatory \$KTD_HOME variable points to an invalid directory.\nIt needs to point to a KTD clone directory.\n\n"
            usage
            exit 1
        fi
    else
        printf "\nThe mandatory \$KTD_HOME variable is not defined. It needs to point to a KTD clone directory.\n\n"
        usage
        exit 1
    fi
fi

exit 0
